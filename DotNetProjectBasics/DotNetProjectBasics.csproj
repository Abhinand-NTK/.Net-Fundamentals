<!--
  The project file (.csproj) tells the .NET SDK HOW to build this project.
  It is plain XML. Open it any time and read it - nothing is hidden.
-->

<!-- Sdk="Microsoft.NET.Sdk" = a normal console/library project.
     Web apps use Sdk="Microsoft.NET.Sdk.Web" instead. -->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- PropertyGroup = settings for the whole project -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>                  <!-- Exe = runnable app, Library = .dll only -->
    <TargetFramework>net10.0</TargetFramework>    <!-- which .NET version to build for -->
    <ImplicitUsings>enable</ImplicitUsings>       <!-- auto-adds common 'using' lines (System, System.Linq, ...) -->
    <Nullable>enable</Nullable>                   <!-- compiler warns about possible nulls -->
    <RootNamespace>DotNetProjectBasics</RootNamespace> <!-- default namespace for new files -->
    <AssemblyName>DotNetProjectBasics</AssemblyName>   <!-- name of the output .dll/.exe -->
    <Version>1.0.0</Version>                      <!-- your app's version number -->
    <Authors>Abhinand NTK</Authors>
  </PropertyGroup>

  <!-- ItemGroup = lists of things: packages, project references, files -->

  <!-- NuGet packages (downloaded from nuget.org by 'dotnet restore') -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <!-- Reference to another project in this repo (the class library) -->
  <ItemGroup>
    <ProjectReference Include="..\SharedLibrary\SharedLibrary.csproj" />
  </ItemGroup>

  <!-- Copy appsettings files into bin/ on every build so the app can find them at runtime -->
  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Global using: available in every .cs file of this project -->
  <ItemGroup>
    <Using Include="System.Reflection" />
  </ItemGroup>

</Project>
